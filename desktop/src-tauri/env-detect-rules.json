{
  "$comment": "Env detection rule tables shared by desktop/src-tauri/src/env_detect.rs and server/src/lib/env-detect.ts (#251). server/src/lib/env-detect-rules.json must stay byte-identical (scripts/env-detect-rules.test.mjs). Patterns use the regex subset common to Rust `regex` and JavaScript; {KEY} expands to keyGroup. secretKeyTokens decides which detected names are keys at all (#287): a name is a key when one of its `_` segments is listed; other names (OUTPUT_DIR, BASE_URL) are the Skill's own configuration and are dropped. SDK catalog keys bypass that check. serviceKeyGroups lists variable names that mean the same service's key (#288); the APP only uses it to suggest linking a new name to a key already in the vault, never to merge names automatically.",
  "keyGroup": "([A-Z][A-Z0-9_]*)",
  "candidateKey": "^[A-Z][A-Z0-9_]{1,99}$",
  "excludedKeys": [
    "PATH",
    "HOME",
    "USER",
    "SHELL",
    "TERM",
    "PWD",
    "TMPDIR",
    "CLAUDE_SKILL_DIR",
    "SKILL_DIR",
    "CLAUDE_PLUGIN_ROOT",
    "ARGUMENTS",
    "NODE_ENV",
    "DEBUG",
    "CI",
    "LANG",
    "TZ"
  ],
  "excludedKeyPrefixes": [
    "LC_"
  ],
  "secretKeyTokens": [
    "KEY",
    "APIKEY",
    "TOKEN",
    "TOKENS",
    "SECRET",
    "SECRETS",
    "PASSWORD",
    "PASSWD",
    "PASSPHRASE",
    "CREDENTIAL",
    "CREDENTIALS",
    "AUTH",
    "PAT"
  ],
  "prunedDirs": [
