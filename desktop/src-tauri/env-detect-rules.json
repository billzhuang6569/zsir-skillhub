  "patterns": {
    "common": [
      "process\\.env\\[\\s*['\"`]{KEY}['\"`]\\s*\\]",
      "process\\.env\\??\\.\\s*{KEY}\\b",
      "import\\.meta\\.env\\.{KEY}\\b",
      "\\bBun\\.env\\??\\.{KEY}\\b",
      "\\benviron\\[\\s*['\"]{KEY}['\"]\\s*\\]",
      "\\benviron\\.get\\(\\s*['\"]{KEY}['\"]",
      "[Gg][Ee][Tt][Ee][Nn][Vv]\\(\\s*['\"]{KEY}['\"]",
      "\\bENV\\[\\s*['\"]{KEY}['\"]\\s*\\]",
      "\\bENV\\.fetch\\(\\s*['\"]{KEY}['\"]",
      "\\benv\\.get\\(\\s*['\"]{KEY}['\"]",
      "\\benv::var(?:_os)?\\(\\s*\"{KEY}\"",
      "\\b(?:option_)?env!\\(\\s*\"{KEY}\"",
      "\\$\\{{KEY}(?:[:?+=-][^}]*)?\\}"
    ],
    "destructuring": "\\{([^{}]*)\\}\\s*=\\s*(?:process\\.env|import\\.meta\\.env|Bun\\.env)\\b",
    "shellBare": "\\${KEY}\\b",
    "powershell": "\\$[Ee][Nn][Vv]:{KEY}\\b",
    "batch": "%{KEY}%",
    "markdownInline": "`([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)`",
    "markdownExport": "\\bexport\\s+{KEY}=",
    "envTemplateLine": "^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*=",
    "pythonImport": "^\\s*import\\s+([A-Za-z0-9_., ]+)",
    "pythonFrom": "^\\s*from\\s+([A-Za-z0-9_.]+)\\s+import\\s+\\(?([A-Za-z0-9_, ]+)",
    "scriptImport": "(?:\\bfrom\\s+|\\brequire\\(\\s*|\\bimport\\(\\s*|\\bimport\\s+)['\"]([^'\"\\s]+)['\"]",
    "pyprojectQuoted": "[\"']([A-Za-z0-9][A-Za-z0-9_.\\-]*)",
    "pyprojectTableKey": "^\\s*([A-Za-z0-9][A-Za-z0-9_.\\-]*)\\s*="
  }
