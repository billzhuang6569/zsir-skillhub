{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.yitan.skillhub",
  "version": "0.33.0",
  "productName": "一探 SkillHub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "一探 SkillHub",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost skillhub-media: http://skillhub-media.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNkIyODU3OTg5MDNCODQKUldTRU81Q1lWeWhyRUFLWHRFcElJK2ptL3FxYkRrejNGK2F3TS9KMnUzWjQrQ3hITHl2VDMzVHEK",
      "endpoints": [
        "https://bill-api.whatonearth.work/skillhub/api/app-updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["skillhub"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "一探 Studio",
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../node_modules/@fontsource/jetbrains-mono/LICENSE": "licenses/JetBrains-Mono-OFL.txt"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
