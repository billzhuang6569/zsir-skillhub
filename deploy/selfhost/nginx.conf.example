# Inside nginx's http {}. Replace skillhub.example.com and certificate paths.
# This template is for nginx on the SAME HOST as Docker's loopback publication.
# The gateway must send X-Forwarded-For (client IP) and X-Forwarded-Proto (https).
# Server trusts the dedicated Compose subnet; overwrite caller-supplied headers.
upstream skillhub_selfhost {
    server 127.0.0.1:3001;
}

# Invitation credentials live in paths. Ordinary access logs must not record URIs.
log_format skillhub_selfhost '$time_iso8601 $request_method $status $request_time';

server {
    access_log /var/log/nginx/skillhub-selfhost.access.log skillhub_selfhost;
    # Redirect diagnostics can contain the complete invitation URL.
    error_log /dev/null;
    listen 80;
    listen [::]:80;
    server_name skillhub.example.com;
    # If this domain already has an HTTP redirect, use that block instead.
    return 301 https://$host$request_uri;
}

server {
    access_log /var/log/nginx/skillhub-selfhost.access.log skillhub_selfhost;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name skillhub.example.com;
    ssl_certificate /etc/ssl/skillhub/fullchain.pem;
    ssl_certificate_key /etc/ssl/skillhub/privkey.pem;
    # Keep at or above the Server's 30 MB Skill import body limit.
    client_max_body_size 32m;

    # Only when nginx is behind YOUR gateway, trust its exact IP/CIDR:
    # set_real_ip_from 192.0.2.10/32;
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;
    # Never trust 0.0.0.0/0 or an arbitrary incoming forwarding header.

    # nginx error records cannot redact request URIs; keep only safe access metrics here.
    location ~ ^/(?:api/team-invites|invite)(?:/|$) {
        error_log /dev/null;
        proxy_pass http://skillhub_selfhost;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID "";
    }

    location / {
        proxy_pass http://skillhub_selfhost;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID "";
    }
}
# For PUBLIC_BASE_URL=https://skillhub.example.com/skillhub use
# location /skillhub/ { proxy_pass http://skillhub_selfhost/; ...same headers... }
# The trailing slash strips the prefix before forwarding to the Server.
# For a path prefix, also prefix the invitation location regex and strip that prefix
# with rewrite ^/skillhub/(.*)$ /$1 break; before its proxy_pass (no URI suffix).
