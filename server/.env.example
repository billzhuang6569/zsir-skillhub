# 部署档：非生产默认 selfhost；生产必须显式设置，官方为 yitan-official。
SKILLHUB_PROFILE=selfhost
# 实例对外地址（可带路径前缀）；生产必填，非回环地址必须 HTTPS，无查询、片段、凭据。
# 官方：PUBLIC_BASE_URL=https://bill-api.whatonearth.work/skillhub
PUBLIC_BASE_URL=http://127.0.0.1:3001
# 自部署头像风格库来源；每 12 小时拉取，断网保留缓存。与 PUBLIC_BASE_URL 使用相同 URL 规则。
AVATAR_STYLE_ORIGIN=https://bill-api.whatonearth.work/skillhub
# selfhost only: trusted official catalog for library acquisition verification
CATALOG_ORIGIN=https://bill-api.whatonearth.work/skillhub
# 可选：管理员预先允许的地址证明 URL（逗号分隔），同 PUBLIC_BASE_URL 校验规则；不可重复或包含主地址。
INSTANCE_ADDITIONAL_BASE_URLS=
# 可选：客户端最低版本（严格 SemVer）；留空时 server-info 返回 null。
MIN_CLIENT_VERSION=

# 默认写入本地；配置 S3 后先 copy 校验再切换。两个本地根目录仍须保留。
STORAGE_DEFAULT=filesystem
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# 相对前缀，不带首尾 /；改变 endpoint/bucket/prefix 会改变 namespace。
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# HTTPS 必须；仅回环和受信任 Compose 单标签服务名允许 HTTP（如 http://seaweedfs:8333）。
# 本地 SeaweedFS 示例使用 16/32 字符以上随机字母数字凭据；云服务凭据无此额外限制。

# 数据库连接（PostgreSQL）
DATABASE_URL="postgresql://skillhub_user:change_me@localhost:5432/skillhub_dev"

# JWT 密钥（生产环境至少 32 字符，请使用随机值）
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
# 300–63072000 秒；官方推荐 31536000（1 年），配合 APP 会话续期。
JWT_EXPIRES_IN_SECONDS=604800

# 认证切换：legacy 保持旧登录；dual/yitan 启用一探 OIDC。
# 本地注册是独立开关；官方生产必须永久为 false，即使应急回退到 legacy 也不可重开。
# yitan 模式仅允许下方 UUID 白名单中的旧账号继续用密码登录完成迁移。
AUTH_MODE=legacy
LOCAL_REGISTRATION_ENABLED=true
# 只接受本地 users.id UUID，不接受邮箱，也绝不按邮箱自动绑定。
AUTH_LEGACY_MIGRATION_ALLOWLIST=
# yitan 目标模式下旧密码登录只签发短时迁移凭证，供 /yitan/link 双重证明。
AUTH_LEGACY_MIGRATION_SESSION_SECONDS=600
AUTH_LOGIN_ATTEMPTS_PER_15_MIN=10
AUTH_LOGIN_IP_ATTEMPTS_PER_15_MIN=100
AUTH_REGISTER_ATTEMPTS_PER_HOUR=5
AUTH_YITAN_EXCHANGE_ATTEMPTS_PER_15_MIN=30
AUTH_YITAN_BACKCHANNEL_ATTEMPTS_PER_MINUTE=300

# 一探统一账号 OIDC 固定合同。官方生产不得改为其他 issuer、JWKS、API audience 或 client。
YITAN_OIDC_ISSUER=https://account.whatonearth.work/realms/yitan
YITAN_OIDC_JWKS_URL=https://account.whatonearth.work/realms/yitan/protocol/openid-connect/certs
YITAN_OIDC_AUDIENCE=skillhub-api
YITAN_OIDC_ALLOWED_AZP=skillhub-desktop,skillhub-web
YITAN_OIDC_CLOCK_TOLERANCE_SECONDS=5
YITAN_OIDC_MAX_TOKEN_AGE_SECONDS=600
YITAN_OIDC_LINK_MAX_AUTH_AGE_SECONDS=600

# Keycloak OIDC Back-Channel Logout：门户以 form-urlencoded logout_token 调用 Server，
# Server 按 issuer+sub 撤销本地产品 JWT，并持久化阻止重放。
# 正式端点：https://sk.woe.show/api/auth/yitan/backchannel-logout
YITAN_OIDC_BACKCHANNEL_LOGOUT_AUDIENCE=skillhub-desktop,skillhub-web
YITAN_OIDC_LOGOUT_MAX_TOKEN_AGE_SECONDS=120

# 隔离测试 realm 的回传端点默认不注册；只有联调窗口显式开启：
# https://sk.woe.show/api/auth/yitan-test/backchannel-logout
YITAN_TEST_BACKCHANNEL_ENABLED=false
YITAN_TEST_OIDC_ISSUER=https://account.whatonearth.work/realms/yitan-test
YITAN_TEST_OIDC_JWKS_URL=https://account.whatonearth.work/realms/yitan-test/protocol/openid-connect/certs
YITAN_TEST_OIDC_BACKCHANNEL_LOGOUT_AUDIENCE=skillhub-desktop-test

# Web 管理端使用 skillhub-web confidential authorization-code + PKCE。
# Secret 只能配置在 Server；AUTH_MODE=dual/yitan 的生产环境必须提供真实值。
YITAN_WEB_CLIENT_ID=skillhub-web
YITAN_WEB_CLIENT_SECRET=replace-with-keycloak-client-secret
YITAN_WEB_REDIRECT_URI=https://sk.woe.show/api/web-admin/yitan/callback
YITAN_WEB_POST_LOGOUT_REDIRECT_URI=https://sk.woe.show/admin/?loggedOut=1
YITAN_WEB_SUCCESS_URL=https://sk.woe.show/admin/
YITAN_WEB_OIDC_TRANSACTION_SECONDS=300
YITAN_WEB_OIDC_TOKEN_TIMEOUT_MS=5000
# 仅事故应急时短时开启；统一账号模式默认永久关闭本地管理员密码入口。
WEB_ADMIN_EMERGENCY_PASSWORD_LOGIN_ENABLED=false
FEEDBACK_ATTEMPTS_PER_HOUR=10

# Tauri 更新清单。发布流程应在同一目录生成临时文件并原子替换此文件。
APP_UPDATE_MANIFEST_PATH=/mnt/pictshare/tan/skillhub/manifests/current.json
ADMIN_AGENT_RELEASE_SUMMARY_PATH=/opt/skillhub/data/admin-agent-release-summary.json
ADMIN_GATEWAY_LOG_PATH=/var/log/skillhub/gateway-access.jsonl

# 仅 LOCAL_REGISTRATION_ENABLED=true 时生效；false 时固定返回 410 AUTH_PORTAL_REQUIRED。
# 未显式设置时：selfhost 默认 invite；yitan-official 保持 open（生产仍禁用本地注册）。
# selfhost 邀请码留空或不设置时关闭注册；生产设置邀请码时至少 16 字符。
# REGISTRATION_MODE=invite
# REGISTRATION_INVITE_CODE=

# Skill 存储与写入配额（防止单账号耗尽数据库空间）
SKILL_MAX_PER_USER=50
SKILL_MAX_VERSIONS_PER_SKILL=30
SKILL_MAX_STORAGE_BYTES_PER_USER=262144000
SKILL_VERSION_WRITES_PER_HOUR=30
# Migration POST requests share a separate per-user hourly budget.
MIGRATION_WRITES_PER_HOUR=1200
MARKETPLACE_DOWNLOADS_PER_MINUTE=60

# 账号 Skill 同步：名片（不可变 Skill 内容包）存放目录，必须是 release 目录之外的绝对路径
SKILL_CARD_STORAGE_DIR=/opt/skillhub/data/skill-cards
# Selfhost media root; deployment must pre-create this absolute directory.
MEDIA_STORAGE_DIR=/opt/skillhub/data/media
LIBRARY_CARD_UPLOADS_PER_HOUR=240
LIBRARY_CARD_DOWNLOADS_PER_MINUTE=120

# 服务端口
PORT=3001
# 正式环境仅监听本机，由 nginx 提供 HTTPS
HOST=127.0.0.1
# 可信反向代理的 IPv4/IPv6 地址或 CIDR，逗号分隔；只配置实际代理，勿信任所有来源。
# 原生部署默认同机 nginx；Docker compose 设置为专用网桥子网。
TRUSTED_PROXIES=127.0.0.1

# 环境
NODE_ENV=development

# 团队钥匙库（团队, KEY）的 32-byte KEK。生产环境必须使用：openssl rand -base64 32
# 下方只是一段格式有效的开发占位值，禁止原样用于生产环境。
CREDENTIAL_KEK_BASE64="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
CREDENTIAL_KEK_VERSION=1
# 可选历史 KEK：仅保留仍有密文引用的旧版本，JSON key 是旧版本号。
# 轮换时先把当前版本和 key 移入此对象，再设置新的当前版本和 key；不要覆盖或删除仍在使用的旧 key。
CREDENTIAL_KEK_KEYRING_JSON='{}'
CREDENTIAL_WRITES_PER_HOUR=30
RUNTIME_ENV_FETCHES_PER_MINUTE=60
CREDENTIAL_MAX_VALUE_BYTES=16384

# 用户反馈截图，仅保存在 ECS 外置云盘的私有目录，不经 nginx 公开。

# AI 分析服务（用于 Skill Profile 生成）
AI_API_BASE_URL=https://cf.api.fan
AI_API_KEY=your_api_key_here
AI_MODEL=kimi-k3
# kimi-k3 当前通过 OpenAI Responses API 调用
AI_PROTOCOL=openai-responses
AI_RATE_LIMIT_PER_MINUTE=6
AI_GLOBAL_DAILY_LIMIT=200
# 自部署默认每位成员每日 50 次（UTC 自然日）；管理员可在 AI 设置中调整实例/个人上限。
# AI 接口测试可能产生少量费用；批量分析先预览并确认，然后按可用额度预留。
AI_PER_USER_DAILY_LIMIT=50
AI_MAX_CONCURRENT=2
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=30000

# CORS 允许的源
CORS_ORIGIN="http://localhost:1420,tauri://localhost"
# Backend only; provision the dedicated Yitan SkillHub App key in the secret store.
PICEM_BASE_URL=https://picem.whatonearth.work
PICEM_API_KEY=
# Image hosts allowed inside topic articles (comma-separated bare host names); others block publishing.
TOPIC_IMAGE_HOSTS=picem-media.whatonearth.work

# Backend only; secret store /opt/skillhub/secrets/fal.json, never Desktop/Web.
# Enable only after credential, generation/recovery and budget acceptance.
FAL_KEY=
SKILL_AVATARS_ENABLED=false
# Unset: selfhost defaults to variants; yitan-official defaults to legacy.
# Existing legacy instances must complete verification before switching; startup verifies the DB.
# SKILL_AVATAR_MODEL_READS=legacy
SKILL_AVATAR_DAILY_LIMIT=200
# Worker steps at once; at most GENERATE of them in the paid LLM prompt + FAL submit stage.
# Avatar prompts are background AI work: GENERATE must be <= AI_MAX_CONCURRENT - 1 so a user
# request always finds a free AI slot; background work also uses at most half of AI_GLOBAL_DAILY_LIMIT.
SKILL_AVATAR_WORKER_CONCURRENCY=4
SKILL_AVATAR_GENERATE_CONCURRENCY=1
CATALOG_TOKEN_TTL_DAYS=30
